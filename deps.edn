;; vis-python-runtime — the embedded CPython runtime the Vis sandbox executes.
;; A small first-party C ABI (`native/vispython`) keeps the raw CPython API
;; behind JDK Foreign Function & Memory downcalls, with no JNI or subprocess.
;;
;; No runtime dependencies on purpose: this library is loaded inside a GraalVM
;; native image, so every dependency becomes reachable code in the consumer.
;; The cdylib is resolved at runtime from VIS_PYTHON_NATIVE_PATH or from a path
;; the host names after unpacking the platform release archive
;; vis-python-runtime-<platform>-<version>.tar.gz.
{:paths ["src/clj" "resources" "target/classes"]

 ;; The bridge is Java, compiled into `target/classes`: FFM downcalls that are
 ;; `invokeExact` against a known signature, and a host upcall whose target is a
 ;; static method — the two shapes a GraalVM native image can keep. Clojure
 ;; keeps only the API. A consumer taking this as a git dependency runs
 ;; `clojure -X:deps prep`; in this checkout, `clojure -T:build javac`.
 :deps/prep-lib {:ensure "target/classes"
                 :alias  :build
                 :fn     javac}

 :deps {}

 :aliases
 {:build
  {:deps {io.github.clojure/tools.build {:mvn/version "0.10.9"}}
   :ns-default build}

  :test
  {:extra-paths ["test"]
   ;; data.json is TEST-ONLY: a block's one success channel is what it printed,
   ;; and the moved runtime tests print JSON.
   :extra-deps  {io.github.cognitect-labs/test-runner
                 {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                 org.clojure/data.json {:mvn/version "2.5.1"}}
   :main-opts   ["-m" "cognitect.test-runner"]
   :exec-fn     cognitect.test-runner.api/test
   ;; FFM downcalls are a restricted operation; opt in so tests do not warn.
   :jvm-opts    ["--enable-native-access=ALL-UNNAMED"]}}}
